{
  "name": "orgo-vnc",
  "version": "0.3.0",
  "description": "Embed Orgo cloud computers in your React app",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "patch-package && tsup",
    "dev": "patch-package && tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "vnc",
    "desktop",
    "remote",
    "cloud",
    "react",
    "orgo"
  ],
  "author": "Orgo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OrgoAI/orgo-vnc"
  },
  "homepage": "https://orgo.ai",
  "type": "commonjs",
  "devDependencies": {
    "@novnc/novnc": "1.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "patch-package": "^8.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
